{
  "name": "travel-with-you-workspace",
  "version": "1.0.0",
  "description": "Full-stack AI-Powered Travel & Discovery Companion for College Students",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --prefix frontend",
    "dev:server": "npm run dev --prefix server",
    "build": "cd frontend && npm install && npm run build",
    "test": "node scripts/test-api.js",
    "seed": "node scripts/seed.js",
    "start": "node server/index.js",
    "install:all": "npm install --prefix server && npm install --prefix frontend"
  },
  "keywords": [
    "travel",
    "ai-companion",
    "students",
    "react19",
    "vite",
    "nodejs",
    "express",
    "tailwind-css"
  ],
  "author": "Travel With You Team",
  "license": "MIT",
  "devDependencies": {
    "isomorphic-git": "^1.42.3"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1"
  }
}
