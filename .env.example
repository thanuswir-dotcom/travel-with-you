# Travel With You Environment Variables Configuration

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Google Gemini AI Integration (Optional: realistic fallback student heuristic engine runs automatically)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:5000/api
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Configuration (Optional: local persistent JSON DB active by default)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
